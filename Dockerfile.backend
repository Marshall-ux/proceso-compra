FROM python:3.12-slim

# Hora de Argentina: las firmas, la auditoría y los PDF se guardan con la hora local.
# Sin esto el contenedor queda en UTC y todo sale 3 h adelantado. tzdata trae la
# definición de las zonas (la imagen slim puede no tenerla).
RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*
ENV TZ=America/Argentina/Buenos_Aires

WORKDIR /app

COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server/ .

EXPOSE 5000

# Servidor de producción (waitress), no el de desarrollo de Flask: sin modo debug ni
# recarga automática. El código queda dentro de la imagen, así que desplegar es
# reconstruirla (ver "Desplegar" en el README).
CMD ["waitress-serve", "--listen=0.0.0.0:5000", "--threads=8", "app:app"]
