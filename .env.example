# Copiá este archivo como .env y poné tus valores reales.
# El .env NO se sube a git (está en .gitignore), así la clave no queda en el repo.

# Clave de administración: se pide para blanquear PIN, generar códigos de alta
# y desbloquear autorizantes en el panel de Autorizados.
ADMIN_PASSWORD=cambiar-esta-clave

# ---------------------------------------------------------------------------
# Mail (avisos de autorización). Sin SMTP_* la app no manda nada: solo loguea el
# intento, y se puede desarrollar y probar sin cuenta de mail.
# ---------------------------------------------------------------------------
APP_NOMBRE=Autorizaciones de Compra
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=neostar.no.reply@gmail.com
# App Password propia de esta app (16 caracteres, SIN los espacios de los 4 grupos).
# Se genera en myaccount.google.com/apppasswords; se revoca sin tumbar las otras apps.
SMTP_PASSWORD=
# Nombre del remitente. Es lo único que distingue a esta app de las otras que
# mandan desde la misma casilla. NUNCA un From @neostar.com.ar: ese dominio está
# en DMARC p=reject y el mail rebota.
MAIL_FROM_NOMBRE=Autorizaciones de Compra

# Con qué dominio se arman los links de los mails. Obligatorio en Docker: el
# request detrás de nginx dice backend:5000 y ese link no le sirve a nadie.
PUBLIC_BASE_URL=http://192.168.41.39

# ---------------------------------------------------------------------------
# Destinatarios de los avisos. Separados por coma; vacío = no se avisa a nadie.
# Si no están acá, mandan los valores por default de server/services/avisos.py.
# ---------------------------------------------------------------------------
# Los autorizantes NO van acá: a cada uno le llega el aviso solo si quien carga
# el gasto lo elige, y su mail se carga en el panel de Autorizados (con la clave).
# Copia fija que recibe TODOS los avisos de gasto nuevo, sea de la marca que sea.
#AUTORIZA_NOTIF_EMAIL=

# Cajeras, por razón social a la que se imputa el gasto.
#CAJA_ALCO_ROSARIO=
#CAJA_NEOSTAR=
#CAJA_XINOXIA=
#CAJA_DASEOS=
#CAJA_HIKARI=
